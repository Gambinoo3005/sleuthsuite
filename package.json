{
  "name": "sleuthsuite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "worker": "node --experimental-strip-types src/crawler/worker.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --experimental-strip-types tests/browser.ts",
    "test:scale": "node --experimental-strip-types tests/scale.ts",
    "setup:browser": "playwright install chromium"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "saxes": "^6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
